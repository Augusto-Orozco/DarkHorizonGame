    m_Metadata:
      m_Items: []
  - m_Id: 76
    m_Localized: "El escuadr\xF3n escap\xF3 con el artefacto."
    m_Metadata:
      m_Items: []
  - m_Id: 77
    m_Localized: El traidor fue eliminado.
    m_Metadata:
      m_Items: []
  - m_Id: 78
    m_Localized: "El traidor acab\xF3 con el escuadr\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 79
    m_Localized: "El escuadr\xF3n cay\xF3 antes de recuperar el artefacto."
    m_Metadata:
      m_Items: []
  - m_Id: 80
    m_Localized: 'Reapariciones: {0}'
