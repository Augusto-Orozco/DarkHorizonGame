  - m_Id: 81
    m_Localized: TRAIDOR
    m_Metadata:
      m_Items: []
  - m_Id: 82
    m_Localized: "Aqu\xED el comandante. Hay 4 Kharvek custodiando las bombotellas.
      Encu\xE9ntrenlos y tr\xE1iganlas a la b\xF3veda."
    m_Metadata:
      m_Items: []
  - m_Id: 83
    m_Localized: Bombotella entregada. Faltan {0}.
    m_Metadata:
      m_Items:
      - rid: 6842420604274737232
  - m_Id: 84
    m_Localized: "\xA1La b\xF3veda est\xE1 abierta! Vayan por el artefacto."
    m_Metadata:
      m_Items: []
  - m_Id: 85
    m_Localized: "Eres el traidor. Elimina al escuadr\xF3n antes de que lleguen a
      la nave."
    m_Metadata:
      m_Items: []
  - m_Id: 86
    m_Localized: "\xA1Hay un traidor entre ustedes! Lleven el artefacto a la nave."
    m_Metadata:
      m_Items: []
  - m_Id: 87
    m_Localized: "\xA1El portador cay\xF3! Recuperen el artefacto."
    m_Metadata:
      m_Items: []
  - m_Id: 88
    m_Localized: "Artefacto recuperado. \xA1Ll\xE9venlo a la nave!"
    m_Metadata:
      m_Items: []
  - m_Id: 89
    m_Localized: "Cay\xF3 un compa\xF1ero. Quedan {0} reapariciones."
    m_Metadata:
      m_Items:
      - rid: 6842420604274737232
  - m_Id: 90
    m_Localized: "\xA1Ya no quedan reapariciones! Si caen todos, se acab\xF3."
    m_Metadata:
      m_Items: []
